# ===== Obrigatórias =====
# Segredo aleatório forte (ex.: openssl rand -hex 32). Exclusivo deste CMS.
PAYLOAD_SECRET=

# Conexão PostgreSQL. É a ÚNICA coisa a trocar na migração Neon -> servidor da ATI-PE.
# Neon (teste):  postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Local/ATI-PE:  postgresql://USUARIO:SENHA@HOST:5432/ipem_cms
DATABASE_URL=

# ===== Opcionais =====
# URL pública deste CMS (usada em URLs absolutas de mídia e em CORS/CSRF).
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000
# Origem(ns) do portal institucional que consumirá a API (separe por vírgula).
FRONTEND_URL=
# Máximo de conexões do pool (Neon free: mantenha baixo; servidor próprio: pode aumentar).
DATABASE_POOL_MAX=10
# Cria/altera tabelas automaticamente. SÓ para prototipagem local; use migrations normalmente.
DATABASE_PUSH=false
# Força cookie "Secure" (padrão: true em produção). Use false só em testes via http.
AUTH_COOKIE_SECURE=

# ===== Armazenamento de mídia =====
# Padrão: disco local em ./media (ou MEDIA_DIR). Faça backup desta pasta.
MEDIA_DIR=
# Para S3-compatível (MinIO/S3), defina o bucket e as credenciais:
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ===== Script create-admin (npm run create-admin) =====
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
