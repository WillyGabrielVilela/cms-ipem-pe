{
  "name": "ipem-pe-cms",
  "version": "0.2.0",
  "private": true,
  "description": "CMS independente do IPEM-PE (Payload 3 + Next.js + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --hostname 127.0.0.1",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload:generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload:generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "create-admin": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/create-admin.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "graphql": "^16.8.1",
    "next": "^16.4.6",
    "payload": "3.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
